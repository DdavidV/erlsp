{erl_opts, [debug_info]}.

%% Umbrella with two sibling apps: behaviour_dep_user (apps/behaviour_dep_user)
%% depends on dep_a (apps/dep_a) and implements dep_a_behaviour, declared in
%% dep_a. Models the real-world "App A is a dependency of App B" scenario
%% without needing rebar3's package/checkouts machinery - both apps' ebins
%% land under the same _build/*/lib/*/ebin glob either way, which is what
%% actually reproduces the stale-profile-shadowing bug.
