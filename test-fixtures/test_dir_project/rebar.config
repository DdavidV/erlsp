{erl_opts, [debug_info]}.

%% test_only_dep_fixture stands in for a real test-only dependency (e.g.
%% meck, katt): declared ONLY under the test profile, so it's absent from
%% a plain `rebar3 compile` and only fetched/built by `rebar3 as test
%% compile`. Its actual source comes from _checkouts/ (see
%% test-fixtures/test_dir_project/_checkout_source/ and the symlink setup
%% this fixture's tests create), since it needs no real network/registry
%% access - rebar3 requires SOME entry here for the checkout to activate
%% at all, but doesn't require it to be a resolvable spec.
{profiles, [
  {test, [
    {deps, [test_only_dep_fixture]}
  ]}
]}.
